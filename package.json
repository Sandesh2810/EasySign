{
  "name": "easysign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && next dev",
    "build": "node scripts/build-tokens.mjs --check && node scripts/copy-pdf-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node design/contrast-check.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "secret-scan": "node scripts/secret-scan.mjs --all",
    "worker": "node scripts/build-worker.mjs && node --env-file=.env.local dist/worker.mjs",
    "worker:once": "node scripts/build-worker.mjs && node --env-file=.env.local dist/worker.mjs --once",
    "test:api": "vitest run --config vitest.api.config.mts",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "csp:report": "node scripts/csp-report.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:drill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/restore-drill.mjs",
    "a11y": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/a11y-audit.mjs",
    "e2e:team": "node scripts/team-e2e.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "dejavu-fonts-ttf": "2.37.3",
    "next": "16.4.6",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "lighthouse": "13.6.0",
    "pg": "8.23.1",
    "puppeteer-core": "25.16.0",
    "rolldown": "1.2.19",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
